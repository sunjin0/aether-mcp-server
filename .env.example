# Hugging Face 模型下载地址；网络受限时可配置镜像地址。
HF_ENDPOINT=https://huggingface.co

# Java 签发、MCP 验证工具委托 JWT 共用的密钥，必须与 Java 一致。
AETHER_MCP_DELEGATION_SECRET=aether-mcp-delegation-dev-secret-change-me

# Docker 内供 MCP 下载聊天附件的 Admin 服务地址。
AETHER_ADMIN_INTERNAL_URL=http://aether-admin:8080

# 可选：OpenAI 兼容视觉模型接口。配置后启用 enhance_image_for_rag 工具。
# AETHER_VISION_API_BASE_URL=https://api.example.com/v1
# AETHER_VISION_MODEL=vision-model-name
# AETHER_VISION_API_KEY=replace-with-a-secret
AETHER_SANDBOX_RUNNER_TOKEN=aether-sandbox-runner-dev-secret-change-me

# 生产环境必须在未提交的 .env 或密钥管理系统中替换委托密钥。
